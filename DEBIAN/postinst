#!/usr/bin/bash


##################################################
# get status install or upgrade from /tmp/initialise-linux-status
# which was created by preinst
# for upgrade (the key may or may not have changed)
#     get the current key id (old key)
#     get the new key id
#     if the new key id is not in the keyring
#        delete the current key id
#        import the new key
#     else
#        the new key = old key do nothing
# for install (the first install)
#     get the current key id
#     import the secret key
# sign the repository
# after the links have been set up /mnt/debhome and /mnt/svn
###################################################


#########################################################################
# main entry point
#########################################################################
# defaults
# TARGET is multi-user.target or graphical.target
DEBHOMEDEVICE="ad64"
DEBHOMEPATH="/mnt/${DEBHOMEDEVICE}/debhome"
SVNDEVICE="ad64"
SVNPATH="/mnt/${SVNDEVICE}/svn"
ARCH=`arch`

# determine if we are upgrading/reinstalling or first install
if test -f "/tmp/initialise-linux-status"; then
	# get the status, either upgrade or install
	STATUS=`cat "/tmp/initialise-linux-status"`
	
	if test "${STATUS}" = "upgrade"; then
		# check if currentkeyid exists
		if test -f "/mnt/debhome/dists/home/currentkeyid.txt"; then
			# get currentkeyid as /mnt/debhome will be available.
			CURRENTKEYID=`cat /mnt/debhome/dists/home/currentkeyid.txt`
			echo "initialise-linux:postinst:upgrade: CURRENTKEYID = [${CURRENTKEYID}]"
			
			# get the new key id from debhomepubkey.gpg
			# as /etc/apt/keyrings/debhomepubkey.gpg will have been replaced with a new one
			if test -f "/etc/apt/keyrings/debhomepubkey.gpg"; then
				# get the new key id
				NEWKEYID=`gpg --show-key "/etc/apt/keyrings/debhomepubkey.gpg" | sed -e '/^[ ]/!d'`
				# remove the leading white space
				echo "${NEWKEYID}" | sed -e 's/^[ ]*//' > "newkeyid.txt"
				# get the newkeyid with leading spaces removed
				NEWKEYID=`cat /tmp/newkeyid.txt`
				
				echo "initialise-linux:postinst:upgrade: NEWKEYID = [${NEWKEYID}]"

				# does the new key exist in the key list
				gpg --list-keys "$NEWKEYID" > "/tmp/newkeyerror.txt" 2>&1
				RC=$?
				
				echo "initialise-linux:postinst:upgrade: RC = ${RC} for NEWKEYID in key list"

				if test ${RC} -ne 0; then
					# new key does not exist in the current list
					# delete the public key and the secret key from /mnt/debhome/currentkeyid
					gpg --batch --yes --delete-secret-key "${CURRENTKEYID}"
					gpg --batch --yes --delete-key "${CURRENTKEYID}"
					
					# import the new secret key
					# not necessary to import the public key
					gpg --batch --yes --import --passphrase 'coahtr3552' "/tmp/debhomeseckey.gpg"
					
					# the key has changed sign the repository
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					echo "initialise-linux:postinst:upgrade: The key has changed, run init-linux to sign the repository"
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					read -t 5 value
				else
					# the key has not changed
					echo " "
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					echo "initialise-linux:postinst:upgrade: The key has not changed"
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
				
				fi	

			else
				# /etc/apt/keyrings/debhomepubkey.gpg not found
				# cannot determine the key id
				echo " "
				echo "++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
				echo "postinst: Cannot determine the new key id as /etc/apt/keyrings/debhomepubkey.gpg not found"
				echo "++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
				
				# wait for a prompt or time out of 5 seconds
				read -t 5 value
			fi
		else
			# /mnt/debhome/dists/home/currentkeyid.txt does not exist
			echo " "
			echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
			echo "initialise-linux:postinst:upgrade: /mnt/debhome/dists/home/currentkeyid.txt not found cannot upgrade key"
			echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
			read -t 5 value
		fi
	
    elif test "${STATUS}" = "install"; then
		# this is the first install

		# for rpi copy debhome-rpi.sources
		if test "${ARCH}" = "aarch64"; then
			if test -f "/tmp/debhome-rpi.list"; then
				# copy debhome-rpi.list if it exists
				cp -vf "/tmp/debhome-rpi.list" "/etc/apt/sources.list.d/"
				exitonerror $? "Could not copy /tmp/debhome-rpi.list /etc/apt/sources.list.d"
				rm -vf "/tmp/debhome-rpi.list"
			fi
		elif test "${ARCH}" = "x86_64"; then
			# if debhome-amd64.list exists copy it
			if test -f "/tmp/debhome-amd64.list"; then
				cp -vf "/tmp/debhome-amd64.list" "/etc/apt/sources.list.d/"
				exitonerror $? "Could not copy /tmp/debhome-amd64.list /etc/apt/sources.list.d"
				rm -vf "/tmp/debhome-amd64.list"
			fi
		else
			exitonerror 1 "Unknown architecture ${ARCH}"
		fi

		# setup the links /mnt/svn /mnt/debhome for the repository
		# invoke setuprepository with default values.
		# the function will prompt if the archive is not found
		# setuprepository "robert" "/mnt/ad64/debhome" "/mnt/debhome
		# import the secret key

		if test -f "/tmp/debhomeseckey.gpg"; then
			# secret key exists, import it
			gpg --batch --yes --passphrase 'coahtr3552' --import "/tmp/debhomeseckey.gpg"

			# check the current key id that was used to sign the repository
			# the /mnt/debhome repository must exist. The links /mnt/svn /mnt/debhome
			# must also be present so setuprepository() must be run before this.
			# invoke setuprepository() with default values
			# if the repositories are not found, they will be prompted for.
			/usr/local/bin/setuprepository "robert" "${DEBHOMEPATH}" "debhome"
			/usr/local/bin/setuprepository "robert" "${SVNPATH}" "svn"
			
			if test -f "/mnt/debhome/dists/home/currentkeyid.txt"; then
				# the current key id is available
				CURRENTKEYID=`cat /mnt/debhome/dists/home/currentkeyid.txt`
				echo "initialise-linux:postinst:install: CURRENTKEYID = ${CURRENTKEYID}"

				# get the new key id
				NEWKEYID=`gpg --show-key "/etc/apt/keyrings/debhomepubkey.gpg" | sed -e '/^[ ]/!d'`
				# remove the leading white space
				echo "${NEWKEYID}" | sed -e 's/^[ ]*//' > "newkeyid.txt"
				# get the newkeyid with leading spaces removed
				NEWKEYID=`cat /tmp/newkeyid.txt`
				echo "initialise-linux:postinst:install: NEWKEYID = [${NEWKEYID}]"

				# if the new key id and the current key id are the same
				# there is no need to sign the repository
				if test "${NEWKEYID}" = "${CURRENTKEYID}"; then
					# not necessary to sign the repository
					echo "equal"
					echo "new key id: [${NEWKEYID}]"
					echo "current key id [${CURRENTKEYID}]"
					echo " "
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					echo "initialise-linux:postinst:install: New key = current key"
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					read -t 5 value
				else
					# the new key is different to the old key.
					# the repository must be signed and apt update run
					echo "not equal"
					echo "new key id: [${NEWKEYID}]"
					echo "current key id [${CURRENTKEYID}]"
					echo " "
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					echo "initialise-linux:postinst:install: New key != current key"
					echo "the repository must be signed with the new key, run apt update"
					echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
					read -t 5 value
				fi

			else
				# /mnt/debhome/dists/home/currentkeyid.txt not found
				# the repository has not been signed
				echo " "
				echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
				echo "initialise-linux:postinst:install: The repository has not been signed."
				echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
				read -t 5 value
			fi
			
		else
			# /tmp/debhomeseckey.gpg not found
			# cannot determine the key id
			echo " "
			echo "++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
			echo "initialise-linux:postinst:install: Cannot determine the key id as /tmp/debhomeseckey.gpg not found"
			echo "++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
			
			# wait for a prompt or time out of 5 seconds
			read -t 5 value
		fi
    fi
else
	# there is no file /tmp/initialise-linux-status
	echo "+++++++++++++++++++++++++++++++++++++++++++++"
	echo "There is no file /tmp/initialise-linux-status"
	echo "cannot import or delete gpg keys"
	echo "+++++++++++++++++++++++++++++++++++++++++++++"
	read -t 5 value
fi

# this code will execute for install or upgrade
# run init-linux with default values to setup account colours, sudoers etc
/usr/local/bin/init-linux

exit 0
