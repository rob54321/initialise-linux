#!/bin/bash
#################################################
# initialise-linux:postrm
#################################################

# only do this for remove, not upgrade
test "$1" = "remove" || exit 0;

ARCH=`arch`

# remove debhomepubkey.asc and debhome.sources and robert from sudoers.d
test -f /etc/apt/keyrings/debhomepubkey.asc && rm -fv /etc/apt/keyrings/debhomepubkey.asc

# for rpi
if test "${ARCH}" = "aarch64"; then
	test -f /etc/apt/sources.list.d/debhome-rpi.list && rm -fv /etc/apt/sources.list.d/debhome-rpi.list
elif test "${ARCH}" = "x86_64"; then
	# for amd64
	test -f /etc/apt/sources.list.d/debhome-amd64.list && rm -fv /etc/apt/sources.list.d/debhome-amd64.list
fi

# write the key id to /tmp/seckey by deleting all lines
# that do not start with ' '
# then use key id from /tmp/seckey to delete it.
gpg --list-secret-keys | sed -e '/^[ ]/!d' > /tmp/seckey && gpg --delete-secret-keys `cat /tmp/seckey`

# sudoers.d/robert is installed by configdata
# so it must be removed by configdata.

#test -f /etc/sudoers.d/robert && rm -fv /etc/sudoers.d/robert

# remove the links for debhome and svn
# debhome and svn must only be links
# and not point to any directory.
# debhome and svn must not be mounted
# is it a link
LIST=(/mnt/debhome /mnt/svn);
for item in "${LIST[@]}"; do
	if test -L "${item}"; then
		# remove link, not recursively
		rm -v "${item}";
	else
		# item is not a link
		# will not remove
		echo "initialise-linux:postrm ${item} is not a link so not removing"
	fi
done;
